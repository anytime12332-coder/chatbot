generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String     @default("Admin")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  chatbots  Chatbot[]
}

model Chatbot {
  id             String   @id @default(uuid())
  name           String   @default("My Chatbot")
  businessName   String   @default("")
  businessInfo   String   @default("") @db.Text
  systemPrompt   String   @default("You are a helpful assistant.") @db.Text
  welcomeMessage String   @default("Hello! How can I help you today?")
  primaryColor   String   @default("#6366f1")
  position       String   @default("bottom-right")
  isActive       Boolean  @default(true)
  statusText     String   @default("Online")
  avatarIcon     String   @default("bot")
  avatarUrl      String   @default("")
  placeholderText String  @default("Type a message...")
  launcherText   String   @default("")
  theme          String   @default("light")
  fontSize       String   @default("medium")
  borderRadius   String   @default("18px")
  starterPrompts String   @default("") @db.Text
  hideBranding   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adminId       String
  admin         Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  apiConfig     ApiConfig?
  conversations Conversation[]

  @@index([adminId])
}

model ApiConfig {
  id          String   @id @default(uuid())
  provider    String   @default("openai")
  apiKey      String   @default("") @db.Text
  model       String   @default("gpt-3.5-turbo")
  baseUrl     String   @default("")
  maxTokens   Int      @default(1024)
  temperature Float    @default(0.7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbotId String  @unique
  chatbot   Chatbot @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
}

model Conversation {
  id          String   @id @default(uuid())
  sessionId   String
  visitorIp   String   @default("")
  visitorName String   @default("Visitor")
  pageUrl     String   @default("")
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chatbotId String
  chatbot   Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([sessionId])
  @@index([chatbotId])
  @@index([createdAt])
}

model Message {
  id             String   @id @default(uuid())
  role           String
  content        String   @db.Text
  tokenCount     Int      @default(0)
  responseTimeMs Int      @default(0)
  createdAt      DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([role])
}
